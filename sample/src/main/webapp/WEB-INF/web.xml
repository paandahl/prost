<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee 
         http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd"
         version="2.5">

    <display-name>Prost Sample Application</display-name>
    <description>Sample application demonstrating the Prost REST framework</description>

    <!-- Context listener to initialize the Prost RequestHandler -->
    <listener>
        <listener-class>com.example.sample.SampleConfigurationListener</listener-class>
    </listener>

    <!-- Prost RequestHandler servlet -->
    <servlet>
        <servlet-name>prostRequestHandler</servlet-name>
        <servlet-class>com.tripfinger.commons.prost.RequestHandler</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <!-- Map all requests to the Prost RequestHandler -->
    <servlet-mapping>
        <servlet-name>prostRequestHandler</servlet-name>
        <url-pattern>/*</url-pattern>
    </servlet-mapping>

</web-app>